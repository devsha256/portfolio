{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "main": false, "master": false } },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/content/health" },
    { "source": "/rss.xml", "destination": "/api/content/rss" },
    { "source": "/sitemap.xml", "destination": "/api/content/sitemap" },
    { "source": "/robots.txt", "destination": "/api/content/robots" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
