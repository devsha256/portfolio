# Local Postgres via PGlite (in-process, no install). Use a Neon URL in production.
DATABASE_URL=pglite://./.data/dev
# GitHub OAuth App (free): callback http://localhost:5173/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The only GitHub login allowed into /admin
ADMIN_GITHUB_LOGIN=devsha256
# Public origin of the app (OAuth redirect, CSRF origin check, feeds)
APP_URL=http://localhost:5173
